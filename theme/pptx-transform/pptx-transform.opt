<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<publishing-template>
    <name>pptx-transform</name>
    <description>Oxygen WebHelp Responsive "tiles" template with the AAAC gram
        pipeline overlays: GramFrame turns each spectrogram table into an
        interactive viewer, and every page carries a protective marking bar top
        and bottom. Point BOTH the instructor and the trainee-filtered scenario
        at this single template; the two scenarios differ only in their
        args.filter DITAVAL and in webhelp.show.search (student: no).</description>
    <webhelp>
        <preview-image file="oxygen-tiles.png"/>
        <parameters>
            <parameter name="webhelp.show.main.page.tiles" value="yes"/>
            <parameter name="webhelp.show.main.page.toc" value="no"/>
            <parameter name="webhelp.top.menu.depth" value="3"/>
            <!-- Stock default is "no". Without this, a week_N.dita page renders
                 as a bare <h1>Week N</h1> — it is a nav container with no body
                 of its own, so its grams are reachable only via the side TOC.
                 Turning it on gives each week a linked list of its grams.
                 No effect on topics with no children (grams, welcome,
                 security). -->
            <parameter name="webhelp.show.child.links" value="yes"/>
            <!-- Stock default is "yes", which spends col-lg-3 (25% of the
                 viewport) on a left sidebar listing every gram in the week.
                 A gram page is a wide spectrogram driven by GramFrame, so that
                 width matters more here than a persistent tree. Grams stay
                 reachable via the week page's child links (above), the top
                 menu, and the prev/next navigation links. -->
            <parameter name="webhelp.show.publication.toc" value="no"/>
            <parameter name="webhelp.enable.dark.mode" value="yes"/>
            <parameter name="args.figurelink.style" value="TITLE"/>
            <parameter name="args.tablelink.style" value="TITLE"/>
            <parameter name="force-unique" value="true"/>

            <!-- ===== Protective marking (issue #175) =====================
                 Consumed by xslt/inc/customProtection.xsl, which fills the two
                 empty bars declared in page-templates-fragments/protection-*.xml.

                 These are the ONLY settings here that a scenario is expected to
                 override, and that is the whole point of them: the delivered
                 target sits behind a one-way air-gap gateway, where editing the
                 template (CSS, XSLT, page layouts, this file) costs a full
                 re-transfer, while a scenario parameter is a local edit on the
                 target. So the marking - the one thing that plausibly differs
                 per export - is a parameter, not literal markup.

                 The marking is the SAME text and colour in both editions;
                 there is no per-edition variation to configure.

                 Leave background.color empty to take the single fixed colour
                 pinned in resources/protection.css (identical in light and dark
                 mode). Set it only for an export that needs a different one. -->
            <parameter name="webhelp.show.protection" value="yes"/>
            <parameter name="webhelp.protection.text" value="COMMERCIALLY SENSITIVE"/>
            <parameter name="webhelp.protection.background.color" value=""/>

            <!-- ===== Search box, per edition (issue #178) ================
                 Consumed by xslt/inc/customSearchFlag.xsl. "yes" here is the
                 INSTRUCTOR default; the student scenario overrides it to "no".

                 The student edition's searchable text is stripped by the
                 trainee DITAVAL, leaving grams that are images with no body
                 text, so its search box only ever returns "no results".

                 This is a scenario parameter rather than a CSS test against
                 page content because index.html is built from the ditamap and
                 search.html is generated by Oxygen: neither carries any
                 content marker, in either edition, so content could not tell
                 them apart. Only the exact value "no" hides the box - anything
                 else leaves the stock behaviour, so a typo cannot silently cost
                 the instructor their search. -->
            <parameter name="webhelp.show.search" value="yes"/>
        </parameters>

        <!-- All four page-type extension points import the same two includes,
             because both customizations must reach every page: a page Oxygen
             builds from the ditamap (index.html) or generates outright
             (search.html) is exactly where issue #178's content-inferred rule
             failed. The four stylesheets are identical apart from a comment. -->
        <xslt>
            <extension file="xslt/customMainPage.xsl"
                       id="com.oxygenxml.webhelp.xsl.createMainPage"/>
            <extension file="xslt/customTopicPage.xsl"
                       id="com.oxygenxml.webhelp.xsl.dita2webhelp"/>
            <extension file="xslt/customSearchPage.xsl"
                       id="com.oxygenxml.webhelp.xsl.createSearchPage"/>
            <extension file="xslt/customIndexTermsPage.xsl"
                       id="com.oxygenxml.webhelp.xsl.createIndexTermsPage"/>
        </xslt>
        <resources>
            <!-- Stock, in Oxygen's own order: oxygen-theme.css defines the wh-*
                 custom properties oxygen.css reads, so it must come first.
                 Never edit these three — overrides go in the overlay CSS below. -->
            <css file="oxygen-theme.css"/>
            <css file="oxygen.css"/>
            <css file="notes.css"/>
            <!-- Project overlays, after the stock styles so they win the
                 cascade. Each is a verbatim copy of the matching theme/
                 overlay folder; tests/test_package_release.py enforces that
                 every copy stays byte-identical to its source. -->
            <css file="resources/hide-search.css"/>
            <css file="resources/gram-nav.css"/>
            <css file="resources/gram-toc-overlay.css"/>
            <css file="resources/dark-mode.css"/>
            <!-- LAST, deliberately: a protective marking must be the one thing
                 no later stylesheet can repaint. It pins its own background and
                 text colour to literals, so it looks the same in light and dark
                 mode. -->
            <css file="resources/protection.css"/>
            <fileset>
                <include name="resources/**/*"/>
                <exclude name="resources/**/*.svn"/>
                <exclude name="resources/**/*.git"/>
            </fileset>
        </resources>
        <!-- Loads gramframe.bundle.js into every topic page <head>; it upgrades
             each <table class="gram-config"> into an interactive spectrogram
             viewer and no-ops on pages with none. The wrapper element must be
             html-fragments (a bare <fragments>, or a <fragment> directly under
             <webhelp>, fails the publish with "Build failed with an exception:
             null"). See theme/gramframe-oxygen/README.md. -->
        <html-fragments>
            <fragment file="page-templates-fragments/libraries/gramframe.xml"
                      placeholder="webhelp.fragment.head.topic.page"/>
            <!-- Pins data-wh-theme="dark" pre-paint, so no light flash and no
                 theme picker. Deliberately webhelp.fragment.head, NOT
                 ...head.topic.page: it must reach every page type (welcome,
                 search results, index terms), not just topics. Oxygen binds one
                 fragment per placeholder, so these two cannot share one.
                 See theme/oxygen-dark-mode/README.md. -->
            <fragment file="page-templates-fragments/libraries/dark-mode.xml"
                      placeholder="webhelp.fragment.head"/>
            <!-- The three body-level placeholders below carry no markup of
                 their own: each holds ONE empty element that the XSLT
                 extensions above fill in or drop, according to the scenario
                 parameters. All three placeholders are included on all four
                 generated page types (main/tiles, topic, search results, index
                 terms), which is what makes the marking unmissable and what
                 fixes issue #178's blind spot on the non-topic pages.
                 Oxygen binds one fragment per placeholder, so each needs its
                 own. -->
            <fragment file="page-templates-fragments/protection-header.xml"
                      placeholder="webhelp.fragment.before.body"/>
            <fragment file="page-templates-fragments/protection-footer.xml"
                      placeholder="webhelp.fragment.after.body"/>
            <fragment file="page-templates-fragments/search-flag.xml"
                      placeholder="webhelp.fragment.after.header"/>
        </html-fragments>
        <online-preview-url>https://www.oxygenxml.com/samples/DITA-WebHelp-Responsive/tiles/oxygen/</online-preview-url>
        <tags>
            <tag type="layout">tiles</tag>
            <tag type="color">blue</tag>
            <tag type="other">dark-mode</tag>
        </tags>
    </webhelp>
    <pdf>
        <preview-image file="oxygen.png"/>
        <tags>
            <tag type="color">white</tag>
        </tags>
        <resources>
            <css file="oxygen-theme.css"/>
            <css file="oxygen-print.css"/>
            <css file="notes.css"/>
            <fileset>
                <include name="*.css"/>
                <include name="resources/**/*.ttf"/>
            </fileset>
        </resources>
    </pdf>
</publishing-template>
